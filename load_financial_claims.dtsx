            <component
              refId="Package\load financial_claims\Source ADO NET"
              componentClassID="Microsoft.ManagedComponentHost"
              contactInfo="Utilise des données issues de SQL Server, OLE DB, ODBC ou Oracle, à l'aide du fournisseur de données .NET Framework correspondant. Utilisez une instruction Transact-SQL pour définir le jeu de résultats. Par exemple, extrayez des données depuis SQL Server à partir du fournisseur de données .NET Framework pour SQL Server.;Microsoft Corporation; Microsoft SQL Server; © Microsoft Corporation; Tous droits réservés; http://www.microsoft.com/sql/support;4"
              description="Utilise des données issues de SQL Server, OLE DB, ODBC ou Oracle, à l'aide du fournisseur de données .NET Framework correspondant. Utilisez une instruction Transact-SQL pour définir le jeu de résultats. Par exemple, extrayez des données depuis SQL Server à partir du fournisseur de données .NET Framework pour SQL Server."
              name="Source ADO NET"
              usesDispositions="true"
              version="4">
              <properties>
                <property
                  dataType="System.String"
                  description="Spécifie l'instruction SQL utilisée par le composant pour extraire des données."
                  expressionType="Notify"
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH bfc_bridge AS (   -- 1) Mapper l'ID du claim vers les codes via la table de pont
    SELECT
        ic.IdPolicy       AS IdPolicyCode,
        ic.IdInsured      AS IdInsuredCode,
        CAST(bfc.premium            AS decimal(10,2)) AS premium,
        CAST(bfc.cost_claims_year   AS decimal(10,2)) AS cost_claim_year,   -- si ta table bronze a "cost_claims_year"
        CAST(bfc.n_medical_services AS int)           AS nbr_medical_service, -- idem "n_medical_services"
        ROW_NUMBER() OVER (
            PARTITION BY ic.IdPolicy, ic.IdInsured
            ORDER BY bfc.id DESC
        ) AS rn
    FROM silver.id_component AS ic
    LEFT JOIN bronze.financial_claim AS bfc
      ON bfc.ID = ic.IdCode         -- &lt;-- le champ ID "int_int" de bronze
),
src AS (            -- 2) Joindre aux dimensions "insured/policy/date_insured"
    SELECT
        si.IdPolicyCode,
        si.IdInsuredCode,
        bb.premium,
        bb.cost_claim_year,
        bb.nbr_medical_service,
        CAST(si.age            AS int)           AS age,
        CAST(si.reimbursement  AS decimal(10,2)) AS reimbursement,
        CAST(p.seniority_policy AS decimal(10,2)) AS seniority_policy,
        CAST(di.tenure_years    AS decimal(10,2)) AS tenure_years
    FROM silver.insured AS si
    LEFT JOIN bfc_bridge AS bb
      ON bb.IdPolicyCode  = si.IdPolicyCode
     AND bb.IdInsuredCode = si.IdInsuredCode
     AND bb.rn = 1                -- garder 1 ligne par (Policy,Insured)
    LEFT JOIN silver.policy AS p
      ON p.IdPolicyCode = si.IdPolicyCode
    LEFT JOIN silver.date_insured AS di
      ON di.IdPolicyCode  = si.IdPolicyCode
     AND di.IdInsuredCode = si.IdInsuredCode
),
calc AS (          -- 3) Calculs
    SELECT
        s.IdPolicyCode,
        s.IdInsuredCode,
        s.premium,
        s.cost_claim_year,
        s.nbr_medical_service,
        CAST(
            CASE WHEN s.premium IS NULL OR s.premium = 0
                 THEN 0 ELSE (s.cost_claim_year / s.premium) * 100
            END AS decimal(10,2)
        ) AS claims_ratio,
        CAST(
            0.5 * (CASE WHEN s.premium IS NULL OR s.premium = 0
                        THEN 0 ELSE (s.cost_claim_year / s.premium) * 100 END)
          + 0.3 * (ISNULL(s.age,0) / 100.0)
          + 0.2 * (ISNULL(s.nbr_medical_service,0) / 30.0)
          AS decimal(10,2)
        ) AS risk_score,
        CAST(
            0.7 * ISNULL(s.seniority_policy,0)
          + 0.3 * ISNULL(s.tenure_years,0)
          + 1.0 - ISNULL(s.reimbursement,0)
          AS decimal(10,2)
        ) AS loyality_score      -- orthographe identique à ta colonne cible
    FROM src AS s
)
SELECT                 -- 4) N’envoyer que les nouvelles paires vers la destination
    c.IdPolicyCode,
    c.IdInsuredCode,
    c.premium,
    c.cost_claim_year,
    c.nbr_medical_service,
    c.claims_ratio,
    c.risk_score,
    c.loyality_score
FROM calc AS c
LEFT JOIN silver.financial_claim AS tgt
  ON tgt.IdPolicyCode  = c.IdPolicyCode
 AND tgt.IdInsuredCode = c.IdInsuredCode
WHERE tgt.IdPolicyCode IS NULL;</property>
                <property
                  dataType="System.Int32"
                  description="Nombre de secondes avant l'expiration d'une commande.  Une valeur égale à 0 indique un délai d'expiration infini."
